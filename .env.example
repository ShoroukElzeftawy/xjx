# Copy this file to .env.local (never commit .env.local).
# Admin email/password are only for https://admin.shopify.com — not for this file.

SHOPIFY_STORE_DOMAIN=xjewelryx-2.myshopify.com

# Shopify Admin → Settings → Apps and sales channels → Develop apps
# → Create an app → Configure Storefront API → products, collections, cart
# → Install → copy the Storefront API access token here.
SHOPIFY_STOREFRONT_TOKEN=
