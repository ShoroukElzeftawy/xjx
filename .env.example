# Copy this file to .env.local (never commit .env.local).
# Admin email/password are only for https://admin.shopify.com — not for this file.

SHOPIFY_STORE_DOMAIN=xjewelryx-2.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# ReferralCandy Join Page URL from Shopify Admin → Referral Candy → campaign → Promote / Widgets
NEXT_PUBLIC_REFERRALCANDY_JOIN_URL=https://xjewelryx.refr.cc/join/default
# Optional: data-id from the Embedded signup iframe snippet
NEXT_PUBLIC_REFERRALCANDY_WIDGET_ID=
